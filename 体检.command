#!/bin/bash
# 双击这个文件即可。窗口会留在原地，方便你看结果。
cd "$(dirname "${BASH_SOURCE[0]}")" || exit 1
clear

cat <<'BANNER'
╔════════════════════════════════════════════════════════════════╗
║  聚酯链驾驶舱 · 部署前体检                                       ║
║  只检查，不改动任何文件                                          ║
╚════════════════════════════════════════════════════════════════╝
BANNER

./tools/deploy_github.sh --check
RC=$?

echo
if [ $RC -eq 0 ]; then
  cat <<'NEXT'
────────────────────────────────────────────────────────────────
  体检通过。

  下一步：在 GitHub 网站上建一个 Public 空仓库
      https://github.com/new
    （名字起个不好猜的，比如 desk-7f3a；不要勾 Add a README）

  建好之后，双击同目录下的「部署.command」。
────────────────────────────────────────────────────────────────
NEXT
else
  echo "  体检没通过，上面有 ✗ 或 ! 的项。把这段输出发给助手看。"
fi

echo
echo "按回车键关闭窗口…"
read -r _
